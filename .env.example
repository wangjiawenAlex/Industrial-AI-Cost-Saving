# 环境变量示例文件
# 复制此文件为 .env 并填写实际的值
# 注意：.env 文件不会提交到 Git，请妥善保管

# DeepSeek API 密钥
# 获取地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-api-key-here

# 数据库配置
# 本地开发：使用 SQLite
DATABASE_URL=sqlite:///./sap_query_demo.db
# 云端部署：使用 PostgreSQL（示例）
# DATABASE_URL=postgresql://user:password@host:5432/sap_query_demo

# 后端配置（用于前端访问）
# 本地开发
BACKEND_URL=http://127.0.0.1:8000
# 云端部署（填写你的后端服务 URL）
# BACKEND_URL=https://your-backend-url.railway.app
